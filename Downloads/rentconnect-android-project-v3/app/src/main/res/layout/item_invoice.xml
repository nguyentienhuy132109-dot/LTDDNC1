<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="[suspicious link removed]"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    tools:ignore="NamespaceTypo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvInvoiceRoomMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phòng ... - Tháng ..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />

            <TextView
                android:id="@+id/tvInvoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái: Chưa thanh toán"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:background="#FFEBEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInvoiceDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiền nhà: 0đ | Điện: 0đ | Nước: 0đ | Phí: 0đ"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvInvoiceTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng tiền: 0 VNĐ"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnConfirmPaid"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="XÁC NHẬN ĐÃ NHẬN TIỀN"
            android:textSize="12sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>