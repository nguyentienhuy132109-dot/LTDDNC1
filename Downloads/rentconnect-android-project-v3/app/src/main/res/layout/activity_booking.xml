<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvBookingHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐẶT LỊCH XEM PHÒNG (BM02)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtBookingDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ngày xem (VD: 2026-11-10)"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtBookingTimeSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Khung giờ (VD: 14:00 - 15:00)"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtBookingPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số điện thoại liên hệ"
        android:inputType="phone"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtBookingNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ghi chú thêm cho chủ trọ"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnSubmitBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GỬI YÊU CẦU ĐẶT LỊCH"
        android:backgroundTint="#0288D1" />
</LinearLayout>
