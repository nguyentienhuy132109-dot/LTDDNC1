<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HỢP ĐỒNG THUÊ NHÀ ĐIỆN TỬ (BM03)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvContractRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phòng thuê: ..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvContractDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời hạn: ..."
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvContractPriceDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giá thuê &amp; Cọc: ..."
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvContractTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điều khoản pháp lý: ..."
            android:background="#EEEEEE"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvContractStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái hợp đồng: ..."
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConfirmContract"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✍️ XÁC NHẬN HỢP ĐỒNG"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
