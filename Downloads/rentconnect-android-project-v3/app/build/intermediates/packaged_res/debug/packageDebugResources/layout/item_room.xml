<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="[suspicious link removed]"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    tools:ignore="NamespaceTypo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvRoomTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiêu đề phòng trọ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />

            <TextView
                android:id="@+id/tvStatusTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn trống"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:background="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoomAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Địa chỉ phòng trọ"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvRoomAreaCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="25.0 m² | Tối đa 3 người"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvRoomPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3,500,000 VNĐ/tháng"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#D32F2F" />

    </LinearLayout>

</androidx.cardview.widget.CardView>