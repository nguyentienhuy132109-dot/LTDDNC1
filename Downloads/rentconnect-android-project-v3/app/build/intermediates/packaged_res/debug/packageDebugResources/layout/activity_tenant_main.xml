<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvTenantHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xin chào Người Thuê!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSensorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Cảm biến ánh sáng đang hoạt động..."
        android:textSize="12sp"
        android:textColor="#333333"
        android:padding="6dp"
        android:background="#E8EAF6"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <!-- Hàng 3 nút song song -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnTenantContract"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hợp Đồng"
                android:textSize="11sp"
                android:backgroundTint="#0288D1"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTenantUtilityInvoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hóa Đơn &amp; QR"
                android:textSize="11sp"
                android:backgroundTint="#388E3C"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTenantTicket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sự Cố Ticket"
                android:textSize="11sp"
                android:backgroundTint="#F57C00" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMyBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 LỊCH HẸN XEM PHÒNG CỦA TÔI"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#00897B" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh Sách Phòng Trọ (Nhấp tag/phòng để xem chi tiết &amp; đặt lịch):"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTenantRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnTenantLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng Xuất"
        android:backgroundTint="#D32F2F" />
</LinearLayout>
