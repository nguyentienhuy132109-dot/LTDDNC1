<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RENTCONNECT"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hệ Thống Hỗ Trợ Thuê &amp; Cho Thuê Nhà"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email đăng nhập"
        android:inputType="textEmailAddress"
        android:text="tenant@rentconnect.vn"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:text="123456"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐĂNG NHẬP"
        android:backgroundTint="#1976D2"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBiometric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👆 ĐĂNG NHẬP VÂN TAY / FACE ID (FR01)"
        android:backgroundTint="#00897B"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGoRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa có tài khoản? Đăng ký ngay"
        android:backgroundTint="#757575" />

</LinearLayout>